# Only the shortlisted garment board and text brief leave this computer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local settings
AIWL_PANEL_SIZE=6
AIWL_TOURNAMENT_BUDGET_USD=3.00
AIWL_TOURNAMENT_SCREEN_CONCURRENCY=3
AIWL_MAX_UPLOAD_MB=12
AIWL_MOBILE_MAX_UPLOAD_MB=30
AIWL_MOBILE_IDLE_MINUTES=15
AIWL_MOBILE_MAX_MINUTES=90
# The launcher sets this automatically to 3001 if another local app owns 3000.
AIWL_MOBILE_WEB_PORT=3000
# AIWL_DATA_DIR=C:\path\to\private\ai-wardrobe-lab-data
